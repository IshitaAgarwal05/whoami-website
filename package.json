{
  "name": "whoami-studios-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w services/api",
    "dev:cms": "npm run dev -w apps/cms",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:cms\"",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w services/api",
    "build:cms": "npm run build -w apps/cms",
    "build": "npm run build -w apps/web && npm run build -w services/api",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
